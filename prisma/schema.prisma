generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UploadedStatus {
  PENDING
  UPLOADED
  FAILED
}

enum ExtractedStatus {
  PENDING
  PROCESSING
  EXTRACTED
  FAILED
}

enum EmbeddingStatus {
  PENDING
  PROCESSING
  EMBEDDED
  FAILED
}

model Document {
  id              String           @id @default(cuid())
  filename        String
  r2Key           String           @unique
  size            Int
  mimetype        String
  uploadedStatus  UploadedStatus   @default(PENDING)
  extractedStatus ExtractedStatus  @default(PENDING)
  embeddingStatus EmbeddingStatus  @default(PENDING)
  embeddingError  String?
  extractedText   String?          @db.Text
  extractionError String?
  createdAt       DateTime         @default(now())
  chunks          DocumentChunks[]

  @@index([extractedStatus, embeddingStatus])
}

model DocumentChunks {
  id         String                       @id @default(cuid())
  documentId String
  document   Document                     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String                       @db.Text
  chunkIndex Int
  charCount  Int
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime                     @default(now())

  @@unique([documentId, chunkIndex])
  @@index([documentId])
}
